{
  "name": "rio-recorder",
  "description": "Local-first Chromium screen recorder and browser-based video editor.",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@remotion/media": "4.0.499",
    "@remotion/player": "4.0.499",
    "@remotion/web-renderer": "4.0.499",
    "@squircle-js/react": "1.3.0",
    "@zip.js/zip.js": "^2.8.34",
    "lucide-react": "^1.27.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remotion": "4.0.499",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  }
}
